#!/bin/bash
#
# Pre-push: run the same fmt + clippy gate CI enforces, so a broken feature
# combination is caught locally instead of after a push + full CI cycle.
#
# These mirror .github/workflows/ci.yml (the `lint` job) exactly, so a green
# hook means a green CI clippy/fmt job. The per-feature clippy lines matter:
# a symbol gated behind one feature (e.g. the coordinator-only veil-front
# external FFI) can compile under one set and break under another — only the
# feature-specific runs catch that.
#
# Bypass in an emergency with `git push --no-verify` (then fix it before CI).

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

run() {
    echo "▸ $*"
    if ! "$@"; then
        echo "✗ pre-push: '$*' failed — fix it or push with --no-verify" >&2
        exit 1
    fi
}

run cargo fmt --all -- --check
run cargo clippy --all-targets -- -D warnings
run cargo clippy --all-targets --features ffi-tls -- -D warnings
run cargo clippy --all-targets --features tonic-transport -- -D warnings

echo "✓ pre-push checks passed"
