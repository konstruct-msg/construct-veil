# ШАБЛОН. Скопируй в hosts.local.sh (он в .gitignore) и впиши РЕАЛЬНЫЕ координаты
# фронтов — ТОЛЬКО из veil-ops, ТОЛЬКО локально. В git этот файл с координатами
# попадать не должен: construct-veil — ПУБЛИЧНЫЙ репозиторий, и любое реальное
# имя/IP/ключ здесь = публично сожжённый фронт (так сожгли прошлый фронт).
#
# Каждый алиас — функция host_<alias>, печатающая три поля через пробел:
#     <ssh-target>  <путь-к-ключу>  <порт relay на проводе>
# capture.sh читает их: read -r SSH_TARGET KEY PORT < <(host_<alias>)

host_front1 () { echo "<user>@<IP-или-хост>  $HOME/.ssh/<key>  443"; }   # relay напрямую на :443
host_front2 () { echo "<user>@<IP-или-хост>  $HOME/.ssh/<key>  8443"; }  # relay за nginx SNI-demux на :8443
